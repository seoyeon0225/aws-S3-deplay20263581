<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>멍냥마켓</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: #f9fafb;
        }
        .hero-bg {
            background-color: #fbeea4; /* 이미지와 유사한 부드러운 노란색 */
        }
        .primary-bg {
            background-color: #f472b6; /* 핑크색 포인트 */
        }
        .primary-text {
            color: #f472b6;
        }
        .filter-btn.active {
            background-color: #f472b6;
            color: white;
            border-color: #f472b6;
        }
        .filter-btn {
            background-color: transparent;
            color: #4b5563;
            border: 1px solid #e5e7eb;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white py-4 px-6 md:px-12 flex justify-between items-center shadow-sm z-10 relative">
        <div class="flex items-center gap-2 cursor-pointer">
            <!-- 🐾 로고 아이콘 대체 -->
            <span class="text-2xl">🐾</span>
            <h1 class="text-xl font-bold text-gray-800">멍냥마켓</h1>
        </div>
        <button class="primary-bg text-white px-5 py-2 rounded-full font-medium flex items-center gap-2 hover:bg-pink-500 transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                <path d="M222.14,58.87A8,8,0,0,0,216,56H54.68L49.79,29.14A16,16,0,0,0,34.05,16H16a8,8,0,0,0,0,16h18L59.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42a28,28,0,1,0,42.95-12.91l6.17-55.51A8,8,0,0,0,204,112H73.34l-3-16h136.5a16,16,0,0,0,15.71-12.86l11.43-62.86A8,8,0,0,0,222.14,58.87ZM84,208a12,12,0,1,1,12-12A12,12,0,0,1,84,208Zm92,0a12,12,0,1,1,12-12A12,12,0,0,1,176,208Zm29.41-112H67.5l-5.82-32H210.6Z"></path>
            </svg>
            장바구니 <span class="bg-white primary-text text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full ml-1">2</span>
        </button>
    </header>

    <!-- Hero Section -->
    <section class="hero-bg py-16 px-6 md:px-12 flex flex-col md:flex-row items-center justify-center gap-10 md:gap-24 w-full max-w-[1920px] mx-auto">
        <div class="flex flex-col gap-4 max-w-lg">
            <h2 class="text-4xl md:text-5xl font-bold text-gray-800 leading-tight">
                우리 아이를 위한<br>
                최고의 선택
            </h2>
            <p class="text-gray-600 text-lg mt-2 font-medium">
                엄선된 프리미엄 사료와 장난감을 만나보세요.
            </p>
        </div>
        <div class="w-full max-w-2xl rounded-3xl overflow-hidden shadow-lg">
            <!-- 고양이와 강아지 이미지 (Unsplash 플레이스홀더 사용) -->
            <img src="https://images.unsplash.com/photo-1543852786-1cf6624b9987?auto=format&fit=crop&q=80&w=1200&h=700" alt="강아지와 고양이" class="w-full h-[300px] md:h-[400px] object-cover" />
        </div>
    </section>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-6 md:px-12 py-12">
        
        <!-- Filters -->
        <div class="flex justify-center gap-3 mb-12 flex-wrap">
            <button class="filter-btn active px-6 py-2 rounded-full font-medium transition-colors" data-filter="all">전체보기</button>
            <button class="filter-btn px-6 py-2 rounded-full font-medium transition-colors bg-white" data-filter="강아지">🐶 강아지</button>
            <button class="filter-btn px-6 py-2 rounded-full font-medium transition-colors bg-white" data-filter="고양이">🐱 고양이</button>
        </div>

        <!-- Product Grid -->
        <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- 상품 카드들은 JavaScript로 렌더링 됩니다. -->
        </div>

    </main>

    <script>
        // 상품 데이터
        const products = [
            {
                id: 1,
                title: "유기농 강아지 사료 2kg",
                category: "강아지",
                image: "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&q=80&w=600&h=450"
            },
            {
                id: 2,
                title: "캣타워 (대형)",
                category: "고양이",
                image: "https://images.unsplash.com/photo-1545249390-6bdfa286032f?auto=format&fit=crop&q=80&w=600&h=450"
            },
            {
                id: 3,
                title: "강아지 삑삑이 장난감",
                category: "강아지",
                image: "https://images.unsplash.com/photo-1535909339361-ef56e179d637?auto=format&fit=crop&q=80&w=600&h=450"
            },
            {
                id: 4,
                title: "고양이 츄르 (20개입)",
                category: "고양이",
                image: "https://images.unsplash.com/photo-1623387641168-d9803ddd3f35?auto=format&fit=crop&q=80&w=600&h=450"
            }
        ];

        const productGrid = document.getElementById('product-grid');
        const filterBtns = document.querySelectorAll('.filter-btn');

        // 상품 렌더링 함수
        function renderProducts(filterCategory = 'all') {
            productGrid.innerHTML = '';
            
            const filteredProducts = filterCategory === 'all' 
                ? products 
                : products.filter(p => p.category === filterCategory);

            filteredProducts.forEach(product => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-100 cursor-pointer group';
                
                card.innerHTML = `
                    <div class="h-48 overflow-hidden bg-gray-100">
                        <img src="${product.image}" alt="${product.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    <div class="p-5">
                        <h3 class="font-bold text-gray-800 text-lg mb-1 truncate">${product.title}</h3>
                        <p class="text-sm text-gray-400">카테고리: ${product.category}</p>
                    </div>
                `;
                productGrid.appendChild(card);
            });
        }

        // 초기 렌더링
        renderProducts();

        // 필터 버튼 클릭 이벤트
        filterBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                // 활성화 스타일 변경
                filterBtns.forEach(b => b.classList.remove('active', 'border-transparent'));
                e.target.classList.add('active');

                // 데이터 필터링
                const filter = e.target.getAttribute('data-filter');
                renderProducts(filter);
            });
        });
    </script>
</body>
</html>
